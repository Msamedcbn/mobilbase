# ─── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL is what the app queries through. On a serverless host every
# concurrent function instance opens its own connection, so it MUST point at a
# pooler (Supabase pgbouncer on :6543, or equivalent) and carry the pgbouncer
# flag — Prisma otherwise uses prepared statements, which transaction-mode
# pooling does not support.
#
#   Supabase pooled  : postgresql://...@<host>:6543/postgres?pgbouncer=true&connection_limit=1
#   Supabase direct  : postgresql://...@<host>:5432/postgres
#
# connection_limit=1 is the right value behind a transaction pooler: the pooler
# does the multiplexing, and letting each instance hold several connections is
# what exhausts the database at 20+ tenants.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vibegsm?schema=public"

# Unpooled connection, used by Prisma for migrations and by
# scripts/apply-indexes-concurrently.sql (CREATE INDEX CONCURRENTLY needs a real
# session, which a transaction pooler cannot give it).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vibegsm?schema=public"

DB_DISABLED_MODE="false"

# How long middleware may reuse a cached tenant-frozen / user-active result.
# Higher = fewer database round-trips; lower = freezes and deactivations take
# effect sooner. Default 30000 (30s).
TENANT_STATUS_TTL_MS="30000"
DEMO_LOGIN_EMAIL="admin@vibegsm.local"
DEMO_LOGIN_PASSWORD="Admin123!"
DEMO_LOGIN_NAME="Sistem Yoneticisi"
DEMO_LOGIN_ROLE="ADMIN"
APP_BASE_URL="http://localhost:3000"
# REQUIRED in production — /api/health/readiness returns 503 until it is set to
# something other than this placeholder. It signs the session cookie; if it is
# left unset the code falls back to a hard-coded default and any visitor can
# forge an admin session. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-long-random-secret"
INTERNAL_API_TOKEN="change-me-in-production"

BUYBACK_NEW_OPS_ENABLED="false"
BUYBACK_RECONCILIATION_ENABLED="false"
BUYBACK_ERP_SYNC_ENABLED="false"
BUYBACK_BACKOFFICE_ENABLED="false"
BUYBACK_BACKOFFICE_ADMIN_ONLY="false"

NEXT_PUBLIC_BUYBACK_NEW_OPS_ENABLED="false"
NEXT_PUBLIC_BUYBACK_RECONCILIATION_ENABLED="false"
NEXT_PUBLIC_BUYBACK_ERP_SYNC_ENABLED="false"
NEXT_PUBLIC_BUYBACK_BACKOFFICE_ENABLED="false"
NEXT_PUBLIC_BUYBACK_BACKOFFICE_ADMIN_ONLY="false"

BUYBACK_NOTIFICATION_EMAIL=""

SMTP_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

SEED_ADMIN_PASSWORD="Admin123!"
TENANT_NAME="VibeGSM"

# ─── LemonSqueezy ─────────────────────────────────────────────────────────────
# Dashboard: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""

# Variant ID'leri — her plan için LemonSqueezy'den alınır
LS_VARIANT_LITE_MONTHLY=""
LS_VARIANT_LITE_ANNUAL=""
LS_VARIANT_SERVICE_MONTHLY=""
LS_VARIANT_SERVICE_ANNUAL=""
LS_VARIANT_PRO_MONTHLY=""
LS_VARIANT_PRO_ANNUAL=""
LS_VARIANT_ENTERPRISE_MONTHLY=""
LS_VARIANT_ENTERPRISE_ANNUAL=""
